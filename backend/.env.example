# Supabase PostgreSQL 연결 정보
# Supabase 대시보드 > Settings > Database 에서 확인
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<your-supabase-db-password>

# JWT 시크릿 (Base64 인코딩된 32바이트 이상 랜덤 문자열)
# 생성 방법: openssl rand -base64 32
JWT_SECRET=<base64-encoded-secret-key>

# Google OAuth2 클라이언트 ID
# Google Cloud Console > APIs & Services > Credentials 에서 확인
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

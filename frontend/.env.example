# Flutter 앱 환경변수
# --dart-define 으로 빌드 시 주입하거나 flutter_dotenv 패키지 사용

# 백엔드 API URL
# 로컬 안드로이드 에뮬레이터: http://10.0.2.2:8080
# 로컬 iOS 시뮬레이터: http://localhost:8080
# 실제 기기 (로컬 개발): http://<로컬IP>:8080
API_BASE_URL=http://10.0.2.2:8080

# Google Maps API Key
# Google Cloud Console > APIs & Services > Credentials
# Maps SDK for Android / Maps SDK for iOS 활성화 필요
GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>
